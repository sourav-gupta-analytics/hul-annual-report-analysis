// Financial
Total Turnover = SUM(Financial[Turnover])
Operating Revenue = SUM(Financial[Revenue])
Total Operating Costs = SUM(Financial[OperatingCosts])
Total EBITDA = SUM(Financial[EBITDA])
Total EBIT = SUM(Financial[EBIT])
Continuing PAT = SUM(Financial[PAT])
EBITDA Margin = DIVIDE([Total EBITDA], [Operating Revenue])
EBIT Margin = DIVIDE([Total EBIT], [Operating Revenue])
PAT Margin = DIVIDE([Continuing PAT], [Operating Revenue])
Cost Ratio = DIVIDE([Total Operating Costs], [Operating Revenue])
Effective Tax Rate = DIVIDE(SUM(Financial[Tax]), SUM(Financial[PBT]))
Turnover PY = VAR y = SELECTEDVALUE('Year'[FY]) RETURN IF(NOT ISBLANK(y), CALCULATE([Total Turnover], FILTER(ALL('Year'), 'Year'[FY] = y - 1)))
Turnover YoY = DIVIDE([Total Turnover] - [Turnover PY], [Turnover PY])
EBITDA PY = VAR y = SELECTEDVALUE('Year'[FY]) RETURN IF(NOT ISBLANK(y), CALCULATE([Total EBITDA], FILTER(ALL('Year'), 'Year'[FY] = y - 1)))
EBITDA YoY = DIVIDE([Total EBITDA] - [EBITDA PY], [EBITDA PY])
PAT PY = VAR y = SELECTEDVALUE('Year'[FY]) RETURN IF(NOT ISBLANK(y), CALCULATE([Continuing PAT], FILTER(ALL('Year'), 'Year'[FY] = y - 1)))
PAT YoY = DIVIDE([Continuing PAT] - [PAT PY], [PAT PY])
Margin change (pp) = VAR y = SELECTEDVALUE('Year'[FY]) VAR prior = IF(NOT ISBLANK(y), CALCULATE([EBITDA Margin], FILTER(ALL('Year'), 'Year'[FY] = y - 1))) RETURN IF(NOT ISBLANK(prior), ([EBITDA Margin] - prior) * 100)
FY25 PAT = CALCULATE([Continuing PAT], FILTER(ALL('Year'), 'Year'[FY] = 2025))
FY26 PAT = CALCULATE([Continuing PAT], FILTER(ALL('Year'), 'Year'[FY] = 2026))
PAT change = [FY26 PAT] - [FY25 PAT]
// Segments
Segment Turnover = SUM(Segments[Turnover])
Segment PY = VAR y = SELECTEDVALUE('Year'[FY]) RETURN IF(NOT ISBLANK(y), CALCULATE([Segment Turnover], FILTER(ALL('Year'), 'Year'[FY] = y - 1)))
Segment YoY = DIVIDE([Segment Turnover] - [Segment PY], [Segment PY])
Segment Share = DIVIDE([Segment Turnover], CALCULATE([Segment Turnover], REMOVEFILTERS(Segments[Segment])))
Segment Change = IF(NOT ISBLANK([Segment PY]), [Segment Turnover] - [Segment PY])
Segment Contribution = DIVIDE([Segment Change], CALCULATE([Segment Change], REMOVEFILTERS(Segments[Segment])))
// Profit Bridge
Profit movement = SUM('Profit Bridge'[Change])
